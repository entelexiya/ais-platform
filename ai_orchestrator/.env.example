# STT (Speech-to-Text) — Alem AI
ALEM_STT_API_KEY=your_alem_stt_key_here
ALEM_STT_URL=https://llm.alem.ai/v1/audio/transcriptions
ALEM_STT_MODEL=speech-to-text

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_STT_MODEL=whisper-1

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp
WHATSAPP_DEMO_CHAT_ID=your_group_chat_id@g.us
ALLOWED_CHAT_ID=your_group_chat_id@g.us

# Backend
DATABASE_URL=sqlite:///./mock.db
BACKEND_URL=http://localhost:8000
